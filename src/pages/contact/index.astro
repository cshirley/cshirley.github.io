---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../site';

const channels = [
  { icon: 'mail', label: 'Email', value: SITE.email, href: `mailto:${SITE.email}` },
  { icon: 'linkedin', label: 'LinkedIn', value: 'linkedin.com/in/cliveshirley', href: SITE.links.linkedin },
  { icon: 'github', label: 'GitHub', value: 'github.com/cshirley', href: SITE.links.github },
];
---
<BaseLayout title="Contact" description="Get in touch with Clive Shirley about software architecture, regulated platforms, payments or AI-assisted delivery.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lead">
        Happy to talk about architecture in regulated domains, payments and pricing, healthcare interoperability,
        platform reliability or putting AI agents to work safely. Email is the quickest way to reach me.
      </p>
    </div>
  </section>
  <section class="container" style="padding-bottom: 6rem;">
    <ul class="contact-list">
      {channels.map((c) => (
        <li>
          <a class="card" href={c.href} rel={c.icon === 'mail' ? undefined : 'me'}>
            <span class="focus-icon"><Icon name={c.icon} /></span>
            <span><strong>{c.label}</strong><span>{c.value}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
