---
import Icon from './Icon.astro';
import { NAV, SITE } from '../site';

const path = Astro.url.pathname;
const isActive = (url: string) =>
  url === '/blog/' ? path.startsWith('/blog') || path.endsWith('.html') : path.startsWith(url);
---
<header class="site-header" id="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="100%" height="100%" focusable="false">
          <rect width="64" height="64" rx="16" fill="#17181b" />
          <g fill="none" stroke="#3dd6be" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 38c3-9 7-10 10-5s6 4 8-3" />
            <path d="M42 13L32 51" />
          </g>
          <circle cx="53" cy="47" r="5" fill="#3dd6be" />
        </svg>
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {NAV.map(({ title, url }) => (
        <a href={url} aria-current={isActive(url) ? 'page' : undefined}>{title}</a>
      ))}
      <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Toggle dark mode">
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  // Flag the header once the page scrolls past 8px. A 1px sentinel at the top and an
  // IntersectionObserver avoid reading scrollY, which forced a synchronous layout on load.
  const sentinel = document.createElement('div');
  sentinel.setAttribute('aria-hidden', 'true');
  sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:8px;pointer-events:none';
  document.body.prepend(sentinel);
  new IntersectionObserver(([entry]) => {
    header?.toggleAttribute('data-scrolled', !entry.isIntersecting);
  }).observe(sentinel);

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
