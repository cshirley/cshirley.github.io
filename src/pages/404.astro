---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" noindex>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>That page has moved on</h1>
      <p class="lead">The page you’re looking for doesn’t exist or was retired when this site was rebuilt.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">Home <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="/blog/">Browse the writing</a>
      </div>
    </div>
  </section>
</BaseLayout>
