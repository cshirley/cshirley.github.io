---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import portrait from '../../assets/clive-shirley-portrait.jpg';
import { SITE } from '../../site';
import { ABOUT_DESCRIPTION, AI_FOCUS, EDUCATION, EXPERIENCE, IMPACT, LEAD_STYLE, LEADERSHIP, PRINCIPLES, STACK, SUMMARY } from '../../data/profile';
---
<BaseLayout
  title="About"
  type="profile"
  description={ABOUT_DESCRIPTION}
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>Architect-practitioner</h1>
      <p class="lead">Hands on the keyboard, designs on the page, and guidance that makes the team successful.</p>
    </div>
  </section>

  <section class="container about-hero">
    <div class="about-intro">
      <div class="prose">
        {SUMMARY.map((p) => <p>{p}</p>)}
        <p>{AI_FOCUS.before} <a href={SITE.links.accord}>{AI_FOCUS.linkLabel}</a>{AI_FOCUS.after}</p>
      </div>
      <aside class="about-aside">
        <Image src={portrait} alt="Portrait of Clive Shirley" width={340} height={340} />
        <dl class="facts">
          <div><dt>Role</dt><dd>Principal Software Engineer, eMed UK</dd></div>
          <div><dt>Based in</dt><dd>{SITE.location}</dd></div>
          <div><dt>Education</dt><dd>{EDUCATION.degree}, {EDUCATION.school}</dd></div>
        </dl>
        <div class="hero-actions about-links">
          <a class="icon-link" href={`mailto:${SITE.email}`} aria-label="Email"><Icon name="mail" /></a>
          <a class="icon-link" href={SITE.links.github} rel="me" aria-label="GitHub"><Icon name="github" /></a>
          <a class="icon-link" href={SITE.links.linkedin} rel="me" aria-label="LinkedIn"><Icon name="linkedin" /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="impact">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">In numbers</p>
          <h2 id="impact">Track record</h2>
        </div>
      </div>
      <div class="grid grid-sm">
        {IMPACT.map((m) => (
          <div class="card metric">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 id="how">Principles</h2>
        </div>
      </div>
      <div class="grid grid-md">
        {PRINCIPLES.map((p) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="style">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Leadership</p>
          <h2 id="style">{LEAD_STYLE.title}</h2>
        </div>
      </div>
      <div class="lead-style">
        <div class="prose">
          {LEAD_STYLE.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ul class="checklist">
          {LEAD_STYLE.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="grid grid-md lead-cards">
        {LEADERSHIP.map((p) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-title" id="experience">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Career</p>
          <h2 id="experience-title">Experience</h2>
        </div>
      </div>
      <ol class="timeline">
        {EXPERIENCE.map((r) => (
          <li>
            <div class="period">{r.period}</div>
            <div>
              <h3>{r.title} <span class="company">· {r.company}</span>{r.note && <span class="note"> ({r.note})</span>}</h3>
              <p class="summary">{r.summary}</p>
              {r.highlights && (
                <ul class="highlights">
                  {r.highlights.map((h) =>
                    typeof h === 'string' ? (
                      <li>{h}</li>
                    ) : (
                      <li>
                        {h.text} <a href={h.href}>{h.label ?? 'Read the write-up'}<span aria-hidden="true"> →</span></a>
                      </li>
                    ),
                  )}
                </ul>
              )}
            </div>
          </li>
        ))}
        <li>
          <div class="period">{EDUCATION.period}</div>
          <div>
            <h3>{EDUCATION.degree} <span class="company">· {EDUCATION.school}</span></h3>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="stack">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Toolbox</p>
          <h2 id="stack">Technical stack</h2>
        </div>
      </div>
      <div class="stack">
        {STACK.map((s) => (
          <div>
            <h3>{s.group}</h3>
            <ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
