{
  "name": "shirley-consulting-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:spelling": "cspell --no-progress && node scripts/check-spelling-style.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:links:drafts": "SHOW_DRAFTS=1 astro build --outDir dist-drafts && DIST_DIR=dist-drafts node scripts/check-links.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "urls:update": "node scripts/check-urls.mjs --update",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run check:spelling && npm run check:skills && npm run build && npm run check:links && npm run check:urls && npm run check:links:drafts",
    "medium": "node scripts/medium-export.mjs",
    "medium:publish": "node scripts/medium-publish.mjs",
    "new-post": "node scripts/new-post.mjs",
    "schedule": "node scripts/schedule.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cspell": "^10.3.6",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
