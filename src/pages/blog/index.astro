---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, type Post } from '../../utils';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---
<BaseLayout title="Writing" description="Writing by Clive Shirley on software architecture, delivery, payments, data platforms and AI-assisted engineering.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h1>Notes from the build</h1>
      <p class="lead">
        Architecture, delivery and lessons learned, from ingesting the Twitter firehose for trading firms to
        white-label banking platforms and agentic engineering.
      </p>
      <p style="margin-top: 1.25rem;"><a class="link-arrow" href="/feed.xml"><Icon name="rss" /> Subscribe via RSS</a></p>
    </div>
  </section>
  <section class="container" style="padding-bottom: 5rem;">
    {[...byYear].map(([year, list]) => (
      <div class="year-group">
        <h2>{year}</h2>
        <PostList posts={list} />
      </div>
    ))}
  </section>
</BaseLayout>
